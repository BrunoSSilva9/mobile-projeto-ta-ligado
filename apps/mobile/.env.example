# App do cidadão (Expo). Copie para .env.
# No Expo Go use o IP da sua máquina na rede local (o celular não enxerga "localhost").
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Apenas para o development build / produção (PEN-04). No Expo Go NÃO são necessárias. ---
# Chave do Google Maps (Android). Lida em app.config.ts.
GOOGLE_MAPS_API_KEY=
# Push (Expo Notifications). Credenciais usadas pelo EAS Build; não vão para o app.
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
EAS_PROJECT_ID=
