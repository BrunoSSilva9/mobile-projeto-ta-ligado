# API do Tá Ligado?. Copie para .env (o .env é ignorado pelo Git).

NODE_ENV=development
PORT=3000

# Mesmos valores do docker-compose.yml (raiz).
DATABASE_URL=postgresql://taligado:taligado@localhost:5432/taligado?schema=public

# Segredo do JWT (mínimo 16 caracteres). Troque em qualquer ambiente fora do seu computador.
JWT_SECRET=troque-este-segredo-de-desenvolvimento

# Origens permitidas no CORS (painel web), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Pasta das fotos (armazenamento local no MVP).
UPLOADS_DIR=uploads

# Seed: conta de operador de TESTE (somente desenvolvimento; não use esta senha em produção).
SEED_OPERADOR_EMAIL=operador@taligado.local
SEED_OPERADOR_SENHA=operador-dev-123
SEED_OPERADOR_NOME=Operador de Teste

# --- Push (Expo Notifications). Sem valor no MVP; pendência PEN-04 (último item do roadmap). ---
EXPO_PUSH_ACCESS_TOKEN=
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
